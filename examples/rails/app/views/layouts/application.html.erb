<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Try Whop payments in a real Rails app. Hosted checkout, signed webhooks and subscription controls, powered by the community pay-whop gem.">
    <title>pay-whop · Rails payment playground</title>
    <%= csrf_meta_tags %>
    <style>
      :root{color-scheme:light;--ink:#18251f;--muted:#59675f;--line:#dce3da;--paper:#f6f7f2;--green:#1b563b;font-family:ui-sans-serif,system-ui,-apple-system,sans-serif}
      *{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);line-height:1.6}a{color:var(--green);text-underline-offset:4px}button{font:inherit;cursor:pointer}button,a{touch-action:manipulation}:focus-visible{outline:3px solid #c56a16;outline-offset:4px}.shell{max-width:1120px;margin:auto;padding:0 28px}.top{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:22px 0;border-bottom:1px solid var(--line)}.brand{font-weight:800;font-size:21px;letter-spacing:-.7px;text-decoration:none;color:var(--ink)}.pill{display:inline-block;background:#e3eddf;color:#28533a;border-radius:24px;padding:4px 11px;font-size:12px;font-weight:700;letter-spacing:.04em}.hero{display:grid;grid-template-columns:1.2fr 1fr;gap:48px;align-items:center;padding:62px 0 48px}.eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:750;color:var(--green)}h1{font-size:clamp(38px,5vw,64px);letter-spacing:-.055em;line-height:1.05;margin:16px 0 22px;font-weight:750;max-width:600px}h2{font-size:23px;letter-spacing:-.03em;margin:0 0 12px}h3{font-size:16px;margin:0 0 8px}.intro{font-size:18px;color:var(--muted);max-width:520px}.muted{color:var(--muted);font-size:14px}.btn{display:inline-block;background:var(--green);border:1px solid var(--green);color:white;border-radius:8px;padding:12px 20px;font-weight:650;text-decoration:none}.btn.secondary{background:white;color:var(--green);padding:7px 12px;font-size:14px}.code{background:#1b2923;color:#e0eddf;padding:26px;border-radius:14px;box-shadow:0 12px 34px #203a2110;overflow:auto}.code p{font:12px ui-monospace,monospace;color:#9cbaa7;margin:0 0 20px}.code pre{margin:0;font:13px/1.8 ui-monospace,SFMono-Regular,monospace;white-space:pre-wrap;overflow-wrap:anywhere}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;border-top:1px solid var(--line);padding:28px 0 40px}.step-number{font:12px ui-monospace,monospace;color:var(--green);margin-bottom:8px}.panel{background:white;border:1px solid var(--line);border-radius:14px;margin:0 0 24px;padding:28px}.panel-head{display:flex;justify-content:space-between;align-items:start;gap:16px}.table{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:14px}th{text-align:left;color:var(--muted);font-size:12px;font-weight:600}td,th{padding:14px 12px 14px 0;border-bottom:1px solid var(--line);vertical-align:middle;overflow-wrap:anywhere}td code{font-size:12px}.empty{padding:20px 0;color:var(--muted)}.notice{padding:16px 20px;background:#fff1d8;border:1px solid #e4c087;border-radius:8px;margin-top:24px}.actions{display:flex;flex-wrap:wrap;gap:10px;align-items:center}.details{display:grid;grid-template-columns:1fr 1fr;gap:24px;padding:16px 0 30px}code{font-family:ui-monospace,SFMono-Regular,monospace;overflow-wrap:anywhere}.test-card{font:19px ui-monospace,monospace;letter-spacing:.02em;margin:12px 0}footer{border-top:1px solid var(--line);padding:24px 0 36px;font-size:13px;color:var(--muted)}footer p{max-width:850px}.status{font-weight:650;color:var(--green)}.skip{position:absolute;left:-10000px}.skip:focus{left:16px;top:10px;background:white;padding:12px;z-index:10}summary{cursor:pointer;font-weight:650}
      @media(max-width:740px){.shell{padding:0 20px}.hero{grid-template-columns:1fr;gap:24px;padding:38px 0 30px}.steps,.details{grid-template-columns:1fr;gap:20px}.steps{padding-bottom:26px}.panel{padding:20px}.panel-head{flex-direction:column}.top{flex-wrap:wrap}.code{padding:20px}h1{font-size:43px}.test-card{font-size:16px}}
    .actions form {margin:0} .actions .btn {font-size:14px} .panel + .panel {margin-top:24px}
    .simulation-panel{border:2px solid #b88737;background:#fffcf5}.simulation-label{background:#fff0ce;color:#6b4710;margin:0 0 12px}.simulation-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.simulation-card{min-width:0;border-top:1px solid #dfc797;padding-top:20px}.simulation-card h4{font-size:14px;margin:20px 0 8px}.simulation-history{padding-left:22px;font-size:13px;color:var(--muted)}
    @media(max-width:740px){.simulation-grid{grid-template-columns:1fr}.simulation-card .btn{max-width:100%;white-space:normal}}
</style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to playground</a>
    <div class="shell">
      <header class="top"><a class="brand" href="/">pay-whop<span aria-hidden="true"> / </span>Rails</a><span class="pill">SANDBOX · NO REAL MONEY</span></header>
      <%= yield %>
      <footer>
        <p>Built by <a href="https://github.com/yshmarov">Yaroslav Shmarov</a>. An early community adapter for <a href="https://github.com/pay-rails/pay">Pay</a>, using Whop's official Ruby SDK. Not an official Whop or Pay integration.</p>
        <p>This browser's encrypted session cookie lasts 30 days. The app stores a random demo identity and billing IDs, amounts and states; card details stay on Whop's hosted checkout. Keep using this browser session with the same Whop sandbox account. No analytics or advertising cookies.</p>
      </footer>
    </div>
  </body>
</html>
