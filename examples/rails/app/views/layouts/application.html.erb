<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>pay-whop · Rails demo</title>
    <%= csrf_meta_tags %>
    <style>
      :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
      body { max-width: 56rem; margin: 3rem auto; padding: 0 1.25rem; line-height: 1.6; }
      h1 { margin-bottom: .25rem; } h2 { margin-top: 2.5rem; }
      button { font: inherit; padding: .5rem 1rem; cursor: pointer; }
      table { width: 100%; border-collapse: collapse; }
      th, td { padding: .75rem; text-align: left; border-bottom: 1px solid #888; overflow-wrap: anywhere; }
      .table { overflow-x: auto; } .muted { opacity: .75; }
      :focus-visible { outline: 3px solid #d65116; outline-offset: 3px; }
      code { overflow-wrap: anywhere; } .notice { border-left: 4px solid #d65116; padding: .75rem; }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
