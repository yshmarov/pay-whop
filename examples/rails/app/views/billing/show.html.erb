<main id="main">
  <% if flash[:alert] %><div class="notice" role="alert"><%= flash[:alert] %></div><% end %>
  <section class="hero" aria-labelledby="hero-title">
    <div>
      <p class="eyebrow">An open-source Rails payment adapter</p>
      <h1 id="hero-title">Whop checkout.<br>Rails all the way back.</h1>
      <p class="intro">Make a test payment. Watch a verified webhook update your Rails subscription. Cancel it, resume it, and inspect the result.</p>
      <% if @customer %>
        <%= button_to "Open Whop sandbox checkout →", checkout_path, class: "btn" %>
      <% else %>
        <%= button_to "Start your sandbox session →", start_session_path, class: "btn" %>
      <% end %>
      <p class="muted">Your own billing session. Test cards only. No real charge.</p>
    </div>
    <div class="code" aria-label="Ruby integration example">
      <p>YOUR RAILS APP / BILLING</p>
      <pre><code>user.set_payment_processor(:whop)

checkout = user.payment_processor.checkout(
  variant_id: "plan_...",
  redirect_url: billing_url
)

redirect_to checkout.purchase_url,
  allow_other_host: true

# After the verified webhook:
user.payment_processor.subscribed? # true</code></pre>
    </div>
  </section>
  <section class="steps" aria-label="How to try the demo">
    <div><div class="step-number">01 / CHECK OUT</div><h3>Pay with a test card</h3><p class="muted">Open the hosted checkout and sign into a Whop sandbox account. Use the test details below.</p></div>
    <div><div class="step-number">02 / SYNC</div><h3>Let the webhook arrive</h3><p class="muted">Whop signs the event. The adapter verifies it, fetches the current state and updates Pay.</p></div>
    <div><div class="step-number">03 / EXPLORE</div><h3>Control your subscription</h3><p class="muted">Schedule a cancellation or keep your subscription. Only your session's records appear here.</p></div>
  </section>
  <section class="panel" aria-labelledby="billing-title">
    <div class="panel-head"><div><h2 id="billing-title">Your sandbox billing</h2><p class="muted"><%= @customer ? "Session ready. Billing changes appear after Whop confirms them." : "Start a session to create your own test customer." %></p></div><%= link_to "Refresh status", root_path(anchor: "billing-title"), class: "btn secondary" %></div>
    <h3>Subscriptions</h3>
    <% if @subscriptions.empty? %>
      <p class="empty">No confirmed subscription yet. Returning from checkout alone does not grant access.</p>
    <% else %>
      <div class="table"><table><thead><tr><th scope="col">Subscription</th><th scope="col">State</th><th scope="col">Period ends</th><th scope="col">Action</th></tr></thead><tbody>
        <% @subscriptions.each do |subscription| %><tr>
          <td><code><%= subscription.processor_id %></code></td>
          <td class="status"><%= subscription.status.humanize %><%= " · cancellation scheduled" if subscription.on_grace_period? %></td>
          <td><%= subscription.current_period_end&.strftime("%d %b %Y, %H:%M UTC") || "—" %></td>
          <td><% if subscription.resumable? %><%= button_to "Keep subscription", resume_subscription_path(subscription), class: "btn secondary" %><% elsif subscription.active? %><%= button_to "Cancel at period end", cancel_subscription_path(subscription), class: "btn secondary" %><% end %></td>
        </tr><% end %>
      </tbody></table></div>
    <% end %>
    <h3 style="margin-top:28px">Payments</h3>
    <% if @charges.empty? %><p class="empty">No successful payment yet.</p><% else %>
      <div class="table"><table><thead><tr><th scope="col">Payment</th><th scope="col">Paid</th><th scope="col">Refunded</th><th scope="col">Action</th></tr></thead><tbody>
        <% @charges.each do |charge| %><tr><td><code><%= charge.processor_id %></code></td><td><%= charge.amount_with_currency %></td><td><%= charge.amount_refunded_with_currency %></td><td><%= button_to "Request test refund", refund_charge_path(charge), class: "btn secondary" unless charge.full_refund? %></td></tr><% end %>
      </tbody></table></div>
    <% end %>
    <p class="muted">Refunds can be unavailable while Whop's sandbox seller funds are pending. A refund does not cancel your subscription.</p>
  </section>
  <section class="details" aria-label="Test instructions and source code">
    <div class="panel"><h2>Your test card</h2><p class="test-card">4242 4242 4242 4242</p><p class="muted">Any future expiry · any 3-digit CVC<br>Use fictional billing details. Never enter a real card.</p><p class="muted">The checkout displays the configured test price and any tax before you submit. All amounts are sandbox money.</p></div>
    <div class="panel"><h2>Use it in your Rails app</h2><p class="muted">The demo runs the same gem in this repository. Follow the setup guide for checkout, migrations and webhook configuration.</p><p><a href="https://github.com/yshmarov/pay-whop">Explore the gem on GitHub →</a></p><p class="muted">Alpha: checkout, subscriptions, cancellation and full-refund requests. Plan swaps, seats and partial refunds are not supported yet.</p></div>
  </section>
</main>
